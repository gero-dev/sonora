<?xml version="1.0" encoding="utf-8"?>
<!--
    Полоса прогресса виджета: скруглённый трек + скруглённое заполнение.
    Используется как android:progressDrawable, поэтому толщина (3dp) и цвет
    задаются здесь, а не через progressTint (иначе тема лончера перекрашивает).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
